# NeuroScan XAI Backend Environment Configuration

# Core Application
PROJECT_NAME="NeuroScan XAI Backend"
VERSION="1.0.0"
DEBUG=False
API_V1_STR="/api"

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL="sqlite:///./neuroscan.db"

# PyTorch Model Checkpoint
MODEL_PATH="models/efficientnet_b0_brain_tumor.pth"
MODEL_CLASSES='["glioma", "meningioma", "pituitary", "notumor"]'
MODEL_DEVICE="cpu" # Options: cpu, cuda, mps

# Monte Carlo Dropout Uncertainty Passes
MC_DROPOUT_PASSES=30

# Dataset Path
DATASET_PATH="../ml/data/raw"

# Upload and Temporary Storage
UPLOAD_DIR="temp_uploads"
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]'
